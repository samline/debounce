{
  "name": "@samline/debounce",
  "version": "1.0.1",
  "description": "Tiny debounce, throttle and rafThrottle with cancel, flush and pending, for vanilla JavaScript, React, Vue, Svelte and plain HTML.",
  "keywords": [
    "debounce",
    "throttle",
    "requestAnimationFrame",
    "react",
    "vue",
    "svelte"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/debounce/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/debounce.git"
  },
  "bugs": {
    "url": "https://github.com/samline/debounce/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/debounce.global.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/debounce.global.js",
  "jsdelivr": "./dist/browser/debounce.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.cjs"
    },
    "./browser": "./dist/browser/debounce.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size && bun run test:e2e",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage",
    "release": "bun run check && pnpm publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svelte": "^5.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.13"
  },
  "size": {
    "./dist/index.js": 1100,
    "./dist/browser/debounce.global.js": 1100,
    "./dist/react/index.js": 1400,
    "./dist/vue/index.js": 1300,
    "./dist/svelte/index.js": 1300
  }
}
